# Copy to .env and fill in. Never commit real secrets.
DATABASE_URL="postgresql://ramizeez:ramizeez@localhost:5432/ramizeez?schema=public"

# 32-byte base64 keys. Generate with: npm run gen:keys
DATA_ENCRYPTION_KEY=""
BLIND_INDEX_KEY=""

# local | staging | production. Test conveniences below are refused when production.
APP_ENV="local"
APP_URL="http://localhost:3000"

# KYC provider: "internal" (built-in checks for testing). "sumsub" will be added later.
KYC_PROVIDER="internal"
# Allow uploading ID/selfie images from files instead of live camera capture (testing only).
KYC_ALLOW_FILE_UPLOAD="true"

# Where encrypted uploaded files are stored (local disk for now; S3 later).
STORAGE_DIR="./storage"

# Show OTP codes on screen until real email/SMS providers are connected (never in production).
DEV_SHOW_OTP="true"

# ── Email delivery ── outbox | resend | sendgrid | smtp
# "outbox" records messages in Admin → Outbox without sending (testing only).
EMAIL_PROVIDER="outbox"
EMAIL_FROM=""                 # e.g. "RamiZeeZ <no-reply@ramizeez.com>" — must be a verified sender
# resend:   https://resend.com  → API key
RESEND_API_KEY=""
# sendgrid: https://sendgrid.com → API key with "Mail Send" permission
SENDGRID_API_KEY=""
# smtp:     Google Workspace, Microsoft 365, Zoho, Amazon SES SMTP, your host's mail server…
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"           # "true" for port 465
SMTP_USER=""
SMTP_PASS=""

# ── SMS delivery ── outbox | twilio | vonage | http
SMS_PROVIDER="outbox"
# twilio: FROM is a Twilio number (+1…), an alphanumeric sender ID, or a Messaging Service SID (MG…)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
# vonage: FROM is a number or sender ID
VONAGE_API_KEY=""
VONAGE_API_SECRET=""
VONAGE_FROM=""
# http: any SMS gateway with an HTTP API (e.g. a Pakistani aggregator). Placeholders:
#   {to} = +923001234567, {to_digits} = 923001234567, {to_local} = 03001234567, {message}
# Example (GET):  SMS_HTTP_URL="https://gateway.example.pk/send?key=XXX&to={to_digits}&text={message}"  SMS_HTTP_METHOD="GET"
# Example (JSON): SMS_HTTP_URL="https://gateway.example.pk/api/sms" SMS_HTTP_METHOD="POST"
#                 SMS_HTTP_CONTENT_TYPE="application/json" SMS_HTTP_BODY='{"to":"{to}","message":"{message}"}'
#                 SMS_HTTP_HEADERS='{"Authorization":"Bearer XXX"}'
SMS_HTTP_URL=""
SMS_HTTP_METHOD="POST"
SMS_HTTP_BODY=""
SMS_HTTP_CONTENT_TYPE=""
SMS_HTTP_HEADERS=""
SMS_HTTP_SUCCESS_MATCH=""     # optional text the gateway's response must contain on success

# Check new passwords against the Have I Been Pwned range API (k-anonymity, fail-open).
HIBP_CHECK="true"

# Seed super admin
SEED_ADMIN_EMAIL="admin@ramizeez.test"
SEED_ADMIN_PASSWORD="ChangeMe!Admin2026"
