# Copy to .env and fill in. Never commit real secrets.
DATABASE_URL="postgresql://ramizeez:ramizeez@localhost:5432/ramizeez?schema=public"

# 32-byte base64 keys. Generate with: npm run gen:keys
DATA_ENCRYPTION_KEY=""
BLIND_INDEX_KEY=""

# local | staging | production. Test conveniences below are refused when production.
APP_ENV="local"
APP_URL="http://localhost:3000"
APP_NAME="RamiZeeZ Ventures"

# KYC provider: "internal" (built-in checks for testing). "sumsub" will be added later.
KYC_PROVIDER="internal"
# Allow uploading ID/selfie images from files instead of live camera capture (testing only).
KYC_ALLOW_FILE_UPLOAD="true"

# Where encrypted uploaded files are stored (local disk for now; S3 later).
STORAGE_DIR="./storage"

# Show OTP codes on screen until real email/SMS providers are connected (never in production).
DEV_SHOW_OTP="true"

# Check new passwords against the Have I Been Pwned range API (k-anonymity, fail-open).
HIBP_CHECK="true"

# Seed super admin
SEED_ADMIN_EMAIL="admin@ramizeez.test"
SEED_ADMIN_PASSWORD="ChangeMe!Admin2026"
