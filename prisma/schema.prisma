// RamiZeeZ Investment Portal — database schema.
// Sensitive values (document numbers, TOTP secrets) are stored encrypted (`*Enc` columns);
// `*Index` columns hold keyed HMAC blind indexes used for duplicate detection.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Accounts & auth ──────────────────────────────────────────────────────────

enum Role {
  FOUNDER
  INVESTOR
  TEAM
}

enum TeamRole {
  SUPER_ADMIN
  VERIFICATION_OFFICER
  DEAL_ANALYST
  INVESTMENT_COMMITTEE
  LEGAL
  FINANCE
  EXECUTION_MANAGER
  MARKETING
  SUPPORT
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  REJECTED
  CLOSED
}

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  emailVerifiedAt    DateTime?
  phone              String // E.164
  phoneVerifiedAt    DateTime?
  passwordHash       String
  firstName          String
  lastName           String
  countryOfResidence String // ISO 3166-1 alpha-2
  roles              Role[]
  teamRole           TeamRole?
  status             AccountStatus @default(ACTIVE)
  statusReason       String?
  tier               Int           @default(0)
  mustChangePassword Boolean       @default(false)

  totpSecretEnc String?
  totpEnabledAt DateTime?
  totpLastStep  Int? // last accepted TOTP time step, blocks code replay
  recoveryCodes String[] // argon2 hashes, consumed codes are removed

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions          Session[]
  otpCodes          OtpCode[]
  files             StoredFile[]
  identityDocuments IdentityDocument[]
  livenessChecks    LivenessCheck[]
  addresses         Address[]
  personalProfile   PersonalProfile?
  education         Education[]
  experience        Experience[]
  pastVentures      PastVenture[]
  references        Reference[]
  goals             GoalsProfile?
  declaration       IntegrityDeclaration?
  investorProfile   InvestorProfile?
  founderProfile    FounderProfile?
  amlScreenings     AmlScreening[]
  cases             VerificationCase[]    @relation("CaseSubject")
  assignedCases     VerificationCase[]    @relation("CaseAssignee")
  decidedCases      VerificationCase[]    @relation("CaseDecider")
  caseNotes         CaseNote[]
  auditLogs         AuditLog[]
  pitches           Pitch[]               @relation("PitchFounder")
  assignedPitches   Pitch[]               @relation("PitchAssignee")
  pitchReviews      PitchReview[]
  pitchEvents       PitchEvent[]
}

enum SessionStage {
  PENDING_2FA
  ACTIVE
}

model Session {
  id         String       @id @default(cuid())
  tokenHash  String       @unique
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage      SessionStage
  ip         String?
  userAgent  String?
  createdAt  DateTime     @default(now())
  lastSeenAt DateTime     @default(now())
  expiresAt  DateTime

  @@index([userId])
}

enum OtpChannel {
  EMAIL
  PHONE
}

model OtpCode {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    OtpChannel
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId, channel])
}

enum MessageStatus {
  RECORDED // outbox provider: stored only, not delivered
  SENT
  FAILED
}

// Log of every email & SMS. With the "outbox" providers (testing) this is the only
// delivery; with real providers, one-time codes are masked before storing.
model OutboundMessage {
  id                String        @id @default(cuid())
  channel           OtpChannel
  to                String
  subject           String?
  body              String
  provider          String        @default("outbox")
  status            MessageStatus @default(RECORDED)
  providerMessageId String?
  error             String?
  createdAt         DateTime      @default(now())

  @@index([to, createdAt])
}

// ─── Files ────────────────────────────────────────────────────────────────────

enum FileKind {
  ID_FRONT
  ID_BACK
  SELFIE
  PROOF_OF_ADDRESS
  PROOF_OF_FUNDS
  BUSINESS_REGISTRATION
  TAX_REGISTRATION
  BANK_STATEMENT
  FINANCIAL_STATEMENT
  PITCH_DECK
  PITCH_IMAGE
  PITCH_DOCUMENT
  OTHER
}

model StoredFile {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind         FileKind
  originalName String?
  mimeType     String
  size         Int
  sha256       String
  storageKey   String   @unique
  liveCapture  Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([sha256])
  @@index([ownerId, kind])
}

// ─── Tier 1: identity ─────────────────────────────────────────────────────────

enum IdDocumentType {
  CNIC
  NICOP
  PASSPORT
  NATIONAL_ID
}

model IdentityDocument {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           IdDocumentType
  numberEnc      String
  numberIndex    String
  numberLast4    String
  issuingCountry String
  fullNameOnDoc  String
  dateOfBirth    DateTime
  gender         String?
  issueDate      DateTime?
  expiryDate     DateTime
  mrz            String?
  frontFileId    String
  backFileId     String?
  createdAt      DateTime       @default(now())

  @@index([numberIndex])
  @@index([userId])
}

model LivenessCheck {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge  String[] // prompts the user was asked to perform, in order
  frameIds   String[] // StoredFile ids, one per prompt
  issuedAt   DateTime
  capturedAt DateTime @default(now())

  @@index([userId])
}

enum AddressKind {
  CURRENT
  PERMANENT
}

model Address {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        AddressKind
  line1       String
  line2       String?
  city        String
  region      String?
  postalCode  String?
  country     String
  proofFileId String?
  verified    Boolean     @default(false)
  updatedAt   DateTime    @updatedAt

  @@unique([userId, kind])
}

// ─── Tier 2: deep profile ─────────────────────────────────────────────────────

model PersonalProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredName      String?
  dateOfBirth        DateTime
  gender             String?
  nationalities      String[]
  fatherOrSpouseName String
  maritalStatus      String?
  dependants         Int?
  languages          String[]
  linkedinUrl        String?
  websiteUrl         String?
  otherLinks         String?
  bio                String
  updatedAt          DateTime @updatedAt
}

model Education {
  id            String  @id @default(cuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution   String
  qualification String
  fieldOfStudy  String?
  startYear     Int?
  endYear       Int?
  notes         String?
  position      Int     @default(0)

  @@index([userId])
}

model Experience {
  id               String  @id @default(cuid())
  userId           String
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  employer         String
  title            String
  startYear        Int
  endYear          Int?
  responsibilities String
  reasonForLeaving String?
  position         Int     @default(0)

  @@index([userId])
}

model PastVenture {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  sector    String
  startYear Int
  endYear   Int?
  outcome   String // RUNNING | SOLD | CLOSED | OTHER
  lessons   String
  position  Int    @default(0)

  @@index([userId])
}

model Reference {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  email        String
  phone        String
  position     Int    @default(0)

  @@index([userId])
}

model GoalsProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals1y           String
  goals5y           String
  goals10y          String
  motivation        String
  causeCare         String
  successDefinition String
  timeCommitment    String // FULL_TIME | PART_TIME | FLEXIBLE
  otherCommitments  String?
  values            String
  setbackStory      String
  updatedAt         DateTime @updatedAt
}

model IntegrityDeclaration {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hasCriminalRecord      Boolean
  hasPendingLitigation   Boolean
  hasBankruptcyOrDefault Boolean
  isPep                  Boolean
  hasConflictOfInterest  Boolean
  details                String?
  truthAffirmed          Boolean
  consentBackgroundCheck Boolean
  signedAt               DateTime
  signedIp               String?
}

// ─── Tier 3: role profiles ────────────────────────────────────────────────────

enum DealType {
  EQUITY
  MUSHARAKAH
  MUDARABAH
  REVENUE_SHARE
}

enum InvestorType {
  INDIVIDUAL
  HIGH_NET_WORTH
  COMPANY
  FUND
  FAMILY_OFFICE
}

model InvestorProfile {
  id                String       @id @default(cuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  investorType      InvestorType
  currency          String
  declaredBudget    Decimal      @db.Decimal(18, 2)
  verifiedBudget    Decimal?     @db.Decimal(18, 2)
  ticketMin         Decimal      @db.Decimal(18, 2)
  ticketMax         Decimal      @db.Decimal(18, 2)
  sourceOfFunds     String[]
  sourceOfWealth    String
  annualIncomeBand  String
  netWorthBand      String
  experience        String
  sectors           String[]
  stages            String[]
  dealTypes         DealType[]
  geographies       String[]
  shariahOnly       Boolean      @default(false)
  riskAnswers       Json
  riskScore         Int
  entityName        String?
  entityRegNumber   String?
  proofOfFundsIds   String[]
  entityDocumentIds String[]
  updatedAt         DateTime     @updatedAt
}

enum FounderStage {
  IDEA
  EXISTING
}

model FounderProfile {
  id                      String       @id @default(cuid())
  userId                  String       @unique
  user                    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage                   FounderStage
  businessName            String?
  sector                  String
  country                 String
  city                    String
  entityType              String? // SOLE_PROPRIETOR | PARTNERSHIP | PRIVATE_LIMITED | LLP | OTHER
  registrationNumber      String?
  taxNumber               String?
  foundedYear             Int?
  employees               Int?
  personalCapital         Decimal?     @db.Decimal(18, 2)
  currency                String
  coFounders              String?
  preferredDealTypes      DealType[]
  documentIds             String[]
  // Acceptance of RamiZeeZ's commercial terms (success fee + business share); see src/config/platform.ts
  platformTermsVersion    String?
  platformTermsAcceptedAt DateTime?
  updatedAt               DateTime     @updatedAt
}

// ─── AML screening (in-house watchlist until an external provider is wired in) ─

model WatchlistEntry {
  id             String    @id @default(cuid())
  fullName       String
  normalizedName String
  aliases        String[]
  dateOfBirth    DateTime?
  country        String?
  listSource     String // e.g. UN_SC, OFAC, NACTA_4TH_SCHEDULE, INTERNAL
  reason         String?
  createdAt      DateTime  @default(now())

  @@index([normalizedName])
}

enum AmlResult {
  CLEAR
  POTENTIAL_MATCH
}

model AmlScreening {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  result          AmlResult
  hits            Json
  screenedName    String
  screenedAt      DateTime  @default(now())
  nextScreeningAt DateTime

  @@index([userId])
}

// ─── Verification cases (review workflow) ─────────────────────────────────────

enum CaseKind {
  IDENTITY // Tier 1
  ROLE // Tier 3
  FINAL // Tier 4
}

enum CaseStatus {
  IN_REVIEW
  NEEDS_INFO
  APPROVED
  REJECTED
}

model VerificationCase {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation("CaseSubject", fields: [userId], references: [id], onDelete: Cascade)
  kind           CaseKind
  status         CaseStatus @default(IN_REVIEW)
  checks         Json // CheckResult[] from the KYC provider
  riskLevel      String // LOW | MEDIUM | HIGH
  provider       String
  applicantNote  String? // e.g. interview availability given by the applicant
  assignedToId   String?
  assignedTo     User?      @relation("CaseAssignee", fields: [assignedToId], references: [id])
  decisionReason String?
  decidedById    String?
  decidedBy      User?      @relation("CaseDecider", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  interviewAt    DateTime?
  interviewNotes String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  notes          CaseNote[]

  @@index([status, kind])
  @@index([userId, kind])
}

model CaseNote {
  id        String           @id @default(cuid())
  caseId    String
  case      VerificationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User             @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime         @default(now())

  @@index([caseId])
}

// ─── Pitches (Phase 3) ────────────────────────────────────────────────────────

enum PitchType {
  IDEA
  EXISTING
}

enum PitchStatus {
  DRAFT
  SUBMITTED // waiting for an analyst
  SCREENING
  DUE_DILIGENCE
  COMMITTEE
  LISTED
  RETURNED // sent back to the founder for changes
  REJECTED
  WITHDRAWN
}

model Pitch {
  id            String      @id @default(cuid())
  founderId     String
  founder       User        @relation("PitchFounder", fields: [founderId], references: [id], onDelete: Cascade)
  status        PitchStatus @default(DRAFT)
  type          PitchType   @default(IDEA)
  savedSections String[]

  // Overview
  title    String
  sector   String?
  country  String?
  city     String?
  oneLiner String?
  problem  String?
  solution String?
  whyNow   String?

  // Team
  teamExperience String?
  teamMembers    Json    @default("[]") // [{ name, role, commitment, equityPercent }]
  advisors       String?
  plannedHires   String?

  // Market
  targetCustomers String?
  marketSize      String?
  competitors     String?
  differentiation String?

  // Business model
  revenueModel  String?
  pricing       String?
  unitEconomics String?
  channels      String?
  partners      String?

  // Current status (existing businesses)
  startedYear       Int?
  employees         Int?
  revenueLast12     Decimal? @db.Decimal(18, 2)
  expensesLast12    Decimal? @db.Decimal(18, 2)
  monthlyRevenue    Decimal? @db.Decimal(18, 2)
  customers         Int?
  tractionNotes     String?
  liabilities       String?
  existingInvestors String?

  // The ask
  currency            String    @default("PKR")
  amount              Decimal?  @db.Decimal(18, 2)
  minTicket           Decimal?  @db.Decimal(18, 2)
  multipleInvestors   Boolean   @default(true)
  dealType            DealType?
  equityPercent       Decimal?  @db.Decimal(5, 2) // EQUITY: stake offered to investors
  profitSharePercent  Decimal?  @db.Decimal(5, 2) // MUSHARAKAH / MUDARABAH: investors' share of profit
  founderCapital      Decimal?  @db.Decimal(18, 2) // MUSHARAKAH: founder's own capital in the partnership
  revenueSharePercent Decimal?  @db.Decimal(5, 2) // REVENUE_SHARE: share of revenue paid to investors
  returnCapMultiple   Decimal?  @db.Decimal(4, 2) // REVENUE_SHARE: payments stop at amount × multiple
  termMonths          Int?
  valuation           Decimal?  @db.Decimal(18, 2) // pre-money
  valuationMethod     String?
  nonFinancialAsks    String?
  expectedReturn      String?
  exitOptions         String?

  // Financials & risks
  projections           Json    @default("[]") // [{ year, revenue, costs, cashFlow }]
  projectionAssumptions String?
  risks                 Json    @default("[]") // [{ category, risk, mitigation }]
  failurePlan           String?

  // Media
  videoUrl        String?
  deckFileId      String?
  imageFileIds    String[]
  documentFileIds String[]

  // Review
  teaser         String? // anonymous investor-facing summary, written by RamiZeeZ at listing
  screeningScore Int? // 0–100
  assignedToId   String?
  assignedTo     User?     @relation("PitchAssignee", fields: [assignedToId], references: [id])
  submittedAt    DateTime?
  listedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  costItems   PitchCostItem[]
  milestones  PitchMilestone[]
  submissions PitchSubmission[]
  reviews     PitchReview[]
  events      PitchEvent[]

  @@index([founderId])
  @@index([status])
}

model PitchCostItem {
  id       String  @id @default(cuid())
  pitchId  String
  pitch    Pitch   @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  category String // CAPEX | OPEX | MARKETING | SALARIES | INVENTORY | LEGAL | TECHNOLOGY | CONTINGENCY | OTHER
  item     String
  quantity Decimal @db.Decimal(14, 2)
  unitCost Decimal @db.Decimal(18, 2)
  timing   String?
  position Int     @default(0)

  @@index([pitchId])
}

/// Execution milestones. Once funded, these become the escrow release schedule.
model PitchMilestone {
  id            String  @id @default(cuid())
  pitchId       String
  pitch         Pitch   @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  month         Int // months after funding
  title         String
  successMetric String
  budget        Decimal @db.Decimal(18, 2)
  owner         String?
  position      Int     @default(0)

  @@index([pitchId])
}

/// Immutable snapshot of each submission, with a SHA-256 fingerprint as proof of authorship.
model PitchSubmission {
  id           String   @id @default(cuid())
  pitchId      String
  pitch        Pitch    @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  version      Int
  fingerprint  String
  snapshot     Json
  termsVersion String
  submittedAt  DateTime @default(now())
  submittedIp  String?

  @@unique([pitchId, version])
}

enum PitchReviewStage {
  SCREENING
  DUE_DILIGENCE
  COMMITTEE
}

model PitchReview {
  id         String           @id @default(cuid())
  pitchId    String
  pitch      Pitch            @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  stage      PitchReviewStage
  reviewerId String
  reviewer   User             @relation(fields: [reviewerId], references: [id])
  scores     Json? // SCREENING: { team, market, model, financials, roadmap, risk } each 1–5
  checklist  Json? // DUE_DILIGENCE: { key: boolean }
  notes      String?
  createdAt  DateTime         @default(now())

  @@index([pitchId, stage])
}

/// Status history, including the feedback shown to the founder.
model PitchEvent {
  id         String       @id @default(cuid())
  pitchId    String
  pitch      Pitch        @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  fromStatus PitchStatus?
  toStatus   PitchStatus
  actorId    String?
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  note       String?
  createdAt  DateTime     @default(now())

  @@index([pitchId])
}

// ─── Audit ────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
